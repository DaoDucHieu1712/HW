{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "MassTransit": "Warning",
        "HW": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hw-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Seq": {
    "Enabled": true,
    "ServerUrl": "http://localhost:5341",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "BufferSize": 10000,
    "BufferPath": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost,3306;database=hw;User=root;Password="
  },
  "MariaDbRetryOptions": {
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:05",
    "ErrorNumbersToAdd": []
  },
  "Jwt": {
    "Key": "THIS_IS_A_SUPER_SECRET_KEY_CHANGE_ME_1234567890",
    "Issuer": "MyCompany.AuthServer",
    "Audience": "MyCompany.ApiClients",
    "AccessTokenExpirationMinutes": 60
  },
  "Anthropic": {
    "Model": "claude-opus-5",
    "MaxTokens": 4096,
    "Effort": "high",
    "ShowThinking": false
  },
  "OpenAI": {
    "Model": "gpt-5",
    "MaxTokens": 4096,
    "ReasoningEffort": "medium",
    "TimeoutSeconds": 300
  },
  "Gemini": {
    "Model": "gemini-2.5-pro",
    "MaxTokens": 4096,
    "TimeoutSeconds": 300
  },
  "Agents": {
    "MaxIterations": 10,
    "MaxDelegations": 8,
    "MaxToolResultChars": 8000,
    "MaxToolResultItems": 25
  },
  "Diagnostics": {
    "Enabled": true,
    "CaptureSql": true,
    "CaptureSqlParameters": false,
    "SqlCapacity": 500,
    "LogCapacity": 1000,
    "MinimumLevel": "Information"
  },
  "Workspace": {
    "Root": "",
    "MaxFileBytes": 400000
  },
  "Chat": {
    "DefaultAgent": "manager",
    "MaxTurns": 30,
    "MaxConversations": 500,
    "IdleMinutes": 120
  }
}
