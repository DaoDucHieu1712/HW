# Copy this to the dotenv file the platform reads (see configs/settings.py ::
# DOTENV_FILENAME) and fill it in. Real environment variables always win, so a
# value exported in the shell overrides whatever is written here.

# --- Claude ---------------------------------------------------------------
# Not required if you have run `ant auth login`: the SDK resolves an OAuth
# profile automatically when no key is set.
ANTHROPIC_API_KEY=

# --- Platform overrides ---------------------------------------------------
AGENT_ENV=development
AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=high
AGENT_MAX_ITERATIONS=3
AGENT_LOG_LEVEL=INFO
# Point this at the repository the agents are allowed to read and write.
AGENT_WORKSPACE_ROOT=..
AGENT_BUILD_COMMAND=dotnet build
AGENT_TEST_COMMAND=dotnet test
# false puts the platform in proposal-only mode: nothing is written, no PR opened.
AGENT_ALLOW_WRITES=true
# true runs the graph without spending tokens.
AGENT_DRY_RUN=false

# --- Jira -----------------------------------------------------------------
JIRA_BASE_URL=
JIRA_PROJECT=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- GitHub ---------------------------------------------------------------
GITHUB_REPO=owner/repository
GITHUB_TOKEN=

# --- Seq ------------------------------------------------------------------
SEQ_BASE_URL=http://localhost:5341
SEQ_API_KEY=

# --- MCP servers (referenced as ${VAR} from configs/mcps.yaml) ------------
SQLSERVER_CONNECTION_STRING=
MONGODB_CONNECTION_STRING=
REDIS_URL=redis://localhost:6379

# --- Observability --------------------------------------------------------
AGENT_OTLP_ENDPOINT=
