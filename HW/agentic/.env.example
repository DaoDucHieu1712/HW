# The only required setting. The loop cannot call a model without it.
ANTHROPIC_API_KEY=sk-ant-...

# Base URL of a running HW.Api. Optional: leave it unset and the loop still plans, codes, builds,
# tests and reviews — it just loses trace_log / trace_sql and the shared patch queue.
HW_API_BASE_URL=http://localhost:5000

# Point the loop at a different repository for one run.
# LOOP_REPO_ROOT=C:\Code\Other\Repo
# LOOP_BUILD_COMMAND=dotnet build MySolution.sln
# LOOP_TEST_COMMAND=dotnet test MySolution.sln
# LOOP_MAX_REPAIR_ATTEMPTS=4
