{
  "name": "loop-agentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A LangGraph feature-development loop for the HW .NET solution: plan, code, build, test, self-repair, review — with human gates on the plan and the patch.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "loop": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
