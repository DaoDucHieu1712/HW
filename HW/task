#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# task — CLI for the HW project agent workflow
# Usage: ./task <command> [args]
# ──────────────────────────────────────────────────────────────
set -euo pipefail

TASKS_DIR="tasks"
CURRENT="$TASKS_DIR/current-task.md"
BACKLOG="$TASKS_DIR/backlog"
DONE_DIR="$TASKS_DIR/done"
PROMPTS=".claude/prompts"

# ── colours ────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}→${RESET} $*"; }
success() { echo -e "${GREEN}✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}!${RESET} $*"; }
error()   { echo -e "${RED}✗${RESET} $*" >&2; }
header()  { echo -e "\n${BOLD}$*${RESET}"; }

# ── helpers ────────────────────────────────────────────────────
require_current_task() {
  if [[ ! -f "$CURRENT" ]]; then
    error "No current task found. Run: ./task new \"Title\""
    exit 1
  fi
}

get_field() {
  local field="$1"
  grep -m1 "^${field}:" "$CURRENT" 2>/dev/null | sed "s/^${field}:[[:space:]]*//" || echo ""
}

set_field() {
  local field="$1" value="$2"
  if grep -q "^${field}:" "$CURRENT"; then
    sed -i "s|^${field}:.*|${field}: ${value}|" "$CURRENT"
  fi
}

next_task_id() {
  local max=0
  for f in "$BACKLOG"/TASK-*.md "$DONE_DIR"/TASK-*.md "$CURRENT"; do
    [[ -f "$f" ]] || continue
    local n
    n=$(grep -m1 "^id:" "$f" 2>/dev/null | grep -o '[0-9]\+' || echo "0")
    (( n > max )) && max=$n
  done
  printf "TASK-%03d" $(( max + 1 ))
}

claude_run() {
  local prompt_text="$1"
  shift
  claude --print \
    --allowedTools "Bash,Read,Write,Edit,Glob,Grep,Agent" \
    --permission-mode acceptEdits \
    "$@" \
    "$prompt_text"
}

# ══════════════════════════════════════════════════════════════
#  COMMANDS
# ══════════════════════════════════════════════════════════════

cmd_help() {
  cat <<EOF

${BOLD}task${RESET} — HW project agent workflow CLI

${BOLD}TASK MANAGEMENT${RESET}
  ./task new <title>             Create a new current task
  ./task show                    Show current task
  ./task edit                    Open current task in \$EDITOR
  ./task set <field> <value>     Set a task field (type, priority, status)
  ./task done                    Archive current task → tasks/done/
  ./task list                    List backlog tasks
  ./task pick <id>               Set a backlog task as current

${BOLD}WORKFLOW (runs Claude agent)${RESET}
  ./task run                     Run full workflow on current task
  ./task run --dry               Preview without applying to disk
  ./task feature <Entity>        Generate a full vertical slice for an entity
  ./task review                  Review changed files against project rules
  ./task migrate <Name>          Create + apply an EF Core migration

${BOLD}EXAMPLES${RESET}
  ./task new "Add Category feature"
  ./task run
  ./task feature Product
  ./task review
  ./task migrate AddProductTable
  ./task done

EOF
}

cmd_new() {
  local title="${1:-}"
  if [[ -z "$title" ]]; then
    error "Usage: ./task new <title>"
    exit 1
  fi

  # Archive existing current task if present
  if [[ -f "$CURRENT" ]]; then
    local old_id old_status
    old_id=$(get_field "id")
    old_status=$(get_field "status")
    if [[ "$old_status" != "done" ]]; then
      warn "Moving existing task '$old_id' to backlog"
      mv "$CURRENT" "$BACKLOG/${old_id}.md"
    fi
  fi

  local id created
  id=$(next_task_id)
  created=$(date +%Y-%m-%d)

  cat > "$CURRENT" <<EOF
---
id: ${id}
type: feature
priority: medium
status: pending
created: ${created}
---

# ${title}

<!-- Describe what needs to be done -->

## Criteria
- [ ] <!-- Add acceptance criteria -->

## Notes
<!-- Any extra context -->
EOF

  success "Created task ${id}: ${title}"
  info "Edit the task: ./task edit"
  info "Run it:        ./task run"
}

cmd_show() {
  require_current_task
  echo ""
  cat "$CURRENT"
  echo ""
  local id type priority status
  id=$(get_field "id"); type=$(get_field "type")
  priority=$(get_field "priority"); status=$(get_field "status")
  echo -e "  ${BOLD}${id}${RESET}  type=${CYAN}${type}${RESET}  priority=${YELLOW}${priority}${RESET}  status=${GREEN}${status}${RESET}"
  echo ""
}

cmd_edit() {
  require_current_task
  "${EDITOR:-notepad}" "$CURRENT"
}

cmd_set() {
  require_current_task
  local field="${1:-}" value="${2:-}"
  if [[ -z "$field" || -z "$value" ]]; then
    error "Usage: ./task set <field> <value>"
    error "Fields: type, priority, status"
    exit 1
  fi
  set_field "$field" "$value"
  success "Set ${field} = ${value}"
}

cmd_done() {
  require_current_task
  local id
  id=$(get_field "id")
  set_field "status" "done"
  local timestamp
  timestamp=$(date +%Y-%m-%d)
  mv "$CURRENT" "$DONE_DIR/${id}-${timestamp}.md"
  success "Task ${id} archived to tasks/done/"
}

cmd_list() {
  header "Backlog"
  local found=0
  for f in "$BACKLOG"/TASK-*.md; do
    [[ -f "$f" ]] || continue
    local id title status
    id=$(get_field "id" 2>/dev/null || echo "?")
    title=$(grep -m1 "^# " "$f" | sed "s/^# //")
    status=$(grep -m1 "^status:" "$f" | sed "s/^status:[[:space:]]*//" || echo "pending")
    echo -e "  ${CYAN}${id}${RESET}  ${title}  [${status}]"
    found=1
  done
  [[ $found -eq 0 ]] && echo "  (empty)"
  echo ""
}

cmd_pick() {
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    error "Usage: ./task pick <id>"
    exit 1
  fi
  local src="$BACKLOG/${id}.md"
  if [[ ! -f "$src" ]]; then
    error "Task ${id} not found in backlog"
    exit 1
  fi

  # Archive current if present
  if [[ -f "$CURRENT" ]]; then
    local cur_id
    cur_id=$(get_field "id")
    mv "$CURRENT" "$BACKLOG/${cur_id}.md"
    warn "Moved ${cur_id} back to backlog"
  fi

  mv "$src" "$CURRENT"
  success "Now working on: ${id}"
  cmd_show
}

cmd_run() {
  require_current_task
  local dry=false
  [[ "${1:-}" == "--dry" ]] && dry=true

  local title id
  title=$(grep -m1 "^# " "$CURRENT" | sed "s/^# //")
  id=$(get_field "id")

  header "Running workflow: ${id} — ${title}"

  local prompt
  prompt=$(cat "$PROMPTS/run-workflow.md")

  if [[ "$dry" == true ]]; then
    warn "DRY RUN — files will not be written to disk"
    prompt="${prompt}

IMPORTANT: This is a dry run. Do NOT write any files. Only describe what would be created/modified."
  fi

  set_field "status" "in_progress"

  info "Invoking Claude agent…"
  claude_run "$prompt"

  if [[ "$dry" == false ]]; then
    info "Run migration when ready:"
    echo "  dotnet ef migrations add Add<Entity> --project HW.Infrastructure --startup-project HW.Api"
    echo "  dotnet ef database update --project HW.Infrastructure --startup-project HW.Api"
  fi
}

cmd_feature() {
  local entity="${1:-}"
  if [[ -z "$entity" ]]; then
    error "Usage: ./task feature <EntityName>"
    exit 1
  fi

  header "Generating feature: ${entity}"

  local prompt
  prompt=$(cat "$PROMPTS/add-feature.md")
  prompt="${prompt/%%ENTITY%%/$entity}"

  info "Invoking Claude agent…"
  claude_run "$prompt"

  info "Run migration when ready:"
  echo "  dotnet ef migrations add Add${entity} --project HW.Infrastructure --startup-project HW.Api"
  echo "  dotnet ef database update --project HW.Infrastructure --startup-project HW.Api"
}

cmd_review() {
  header "Reviewing changed files"
  local prompt
  prompt=$(cat "$PROMPTS/review.md")
  claude_run "$prompt"
}

cmd_migrate() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    error "Usage: ./task migrate <MigrationName>"
    exit 1
  fi

  header "Creating migration: ${name}"
  info "Running: dotnet ef migrations add ${name}"

  dotnet ef migrations add "$name" \
    --project HW.Infrastructure \
    --startup-project HW.Api

  info "Applying to database…"
  dotnet ef database update \
    --project HW.Infrastructure \
    --startup-project HW.Api

  success "Migration ${name} applied."
}

# ══════════════════════════════════════════════════════════════
#  DISPATCH
# ══════════════════════════════════════════════════════════════
cmd="${1:-help}"
shift || true

case "$cmd" in
  new)      cmd_new "$@" ;;
  show)     cmd_show ;;
  edit)     cmd_edit ;;
  set)      cmd_set "$@" ;;
  done)     cmd_done ;;
  list)     cmd_list ;;
  pick)     cmd_pick "$@" ;;
  run)      cmd_run "$@" ;;
  feature)  cmd_feature "$@" ;;
  review)   cmd_review ;;
  migrate)  cmd_migrate "$@" ;;
  help|-h|--help) cmd_help ;;
  *)
    error "Unknown command: ${cmd}"
    cmd_help
    exit 1
    ;;
esac
